<%@ Page Title="מדריך מערכת שימון המנוע" Language="C#" MasterPageFile="~/MasterPage.Master" AutoEventWireup="true" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
</asp:Content>

<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
    <div class="container my-5" style="direction:rtl; text-align:right;">
        <h1 class="mb-4">מערכת שימון המנוע</h1>
        
        <div class="row g-4 align-items-center">
            <div class="col-md-4 text-center">
                <img src="/Images/engine_lubrication.jpg" alt="מערכת שמן במנוע רכב" class="img-fluid rounded bigPicImg" style="width: 100%; height: auto;" />
            </div>
            
            <div class="col-md-8">
                <div class="engine-info-box">
                    <h3>🧼 יעילות הידראולית</h3>
                    <p class="mt-3">
                        מערכת השימון לא רק "יושבת" בתחתית המנוע, אלא משתמשת במשאבה מיוחדת ומתיזה את שמן המנוע בלחץ גבוה דרך מעברי שמן ייעודיים לכל החלקים הנעים. השמן פועל בטמפרטורת עבודה גבוהה כדי להפחית חיכוך, למנוע שחיקה ולשטוף משקעי פיח שומניים ביעילות.
                    </p>
                </div>
            </div>
        </div>
    </div>
</asp:Content>